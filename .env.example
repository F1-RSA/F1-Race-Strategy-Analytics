# Local defaults: `cp .env.example .env` works without edits.
# Never commit .env or real credentials.

# --- PostgreSQL (local pipeline) ---
POSTGRES_USER=f1
POSTGRES_PASSWORD=f1_local_dev
POSTGRES_DB=f1_db
# Hostname inside the compose network; use localhost when connecting from the host
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- GCP (final milestone only, leave empty for the local pipeline) ---
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
BQ_DATASET=f1_raw

# --- OpenF1 client and shared HTTP layer (ingestion) ---
OPENF1_BASE_URL=https://api.openf1.org/v1
# OpenF1 publishes no limit and sends no rate-limit headers; stay below the assumed 30/min
OPENF1_REQUESTS_PER_MINUTE=24
OPENF1_BURST=2
HTTP_TIMEOUT_SECONDS=30
# Retries on 429, 5xx, timeouts and connection errors; backoff = uniform(0, min(max, base * 2^attempt))
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_BASE_SECONDS=1
HTTP_BACKOFF_MAX_SECONDS=60

# --- Jolpica client (ingestion) ---
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
# Jolpica allows 4 requests/second and 500/hour (and announces lower limits); 6/min = 360/hour
JOLPICA_REQUESTS_PER_MINUTE=6
JOLPICA_BURST=2
JOLPICA_USER_AGENT=f1-rsa-hslu-deng-hs26/1.0
